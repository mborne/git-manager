{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - {{ project.fullname }} - secrets{% endblock %}

{% block body %}
{# the matched content of these rules is never displayed as it is the secret itself #}
{% set maskedRuleIds = ['private-key'] %}

<div class="container-fluid">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_project_index') }}">Projects</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_project_details', {'id': project.id}) }}">{{ project.fullname }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Secrets</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 mb-2">{{ project.fullname }} <span class="text-secondary fw-normal">- secrets</span></h1>
            <div class="d-flex flex-wrap gap-1">
                {% for ruleId, count in secretCountByRuleId %}
                    <span class="badge text-bg-danger">{{ ruleId }}&nbsp;: {{ count }}</span>
                {% endfor %}
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" href="{{ project.httpUrl }}" target="_blank" rel="noopener">
                <span class="material-icons fs-6">open_in_new</span>
                Open repository
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Secrets <span class="text-secondary fw-normal">(gitleaks)</span></span>
            <span class="badge text-bg-{{ secretFindings is empty ? 'success' : 'danger' }}">{{ secretFindings|length }}</span>
        </div>
        {% if secretFindings is empty %}
            <div class="card-body text-success mb-0">No secret found.</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Rule</th>
                            <th scope="col">File</th>
                            <th scope="col" class="text-end">Line</th>
                            <th scope="col">Match</th>
                            <th scope="col">Commit</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for finding in secretFindings %}
                        {% set ruleId = finding.ruleId|default('-') %}
                        {% set location = finding.locations[0].physicalLocation|default({}) %}
                        {% set snippet = location.region.snippet.text|default('-') %}
                        {% set filePath = location.artifactLocation.uri|default('') %}
                        {% set startLine = location.region.startLine|default(null) %}
                        {% set commitSha = finding.partialFingerprints.commitSha|default(null) %}
                        {# the file is linked to the exact commit when the host is supported (ex : github.com) #}
                        {% set fileUrl = source_file_url(project.httpUrl, filePath, commitSha, startLine, project.defaultBranch) %}
                        <tr>
                            <td><span class="badge text-bg-danger">{{ ruleId }}</span></td>
                            <td class="font-monospace small text-break">
                                {% if fileUrl is not null %}
                                    <a href="{{ fileUrl }}" target="_blank" rel="noopener">{{ filePath }}</a>
                                {% else %}
                                    {{ filePath|default('-') }}
                                {% endif %}
                            </td>
                            <td class="text-end">{{ startLine|default('-') }}</td>
                            <td>
                                {% if ruleId in maskedRuleIds %}
                                    <span class="text-secondary fst-italic">(masked)</span>
                                {% else %}
                                    <code class="text-break">{{ snippet|slice(0, 120) }}{{ snippet|length > 120 ? '…' : '' }}</code>
                                {% endif %}
                            </td>
                            <td class="font-monospace small">{{ commitSha|default('-')|slice(0, 8) }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
