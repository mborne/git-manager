{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - {{ project.fullname }}{% endblock %}

{% block body %}
<div class="container">
    <h1>{{ project.fullname }}</h1>

    <h2>Properties</h2>

    <ul>
        <li>URL : <a href="{{ project.httpUrl }}" target="_blank">{{ project.httpUrl }}</a></li>
        <li>Archived : {{ project.archived ? 'YES' : 'NO' }}</li>
    </ul>

    <h2>Checks</h2>

    <ul>
        <li><b>README</b> :
            {% if project.checks.readme %}
                <span style="color: green">YES</span>
            {% else %}
                <span style="color: red">NO</span>
            {% endif %}
        </li>
        <li><b>LICENSE</b> : 
            {% if project.checks.license %}
                <span style="color: green">{{project.checks.license}}</span>
            {% else %}
                <span style="color: red">MISSING</span>
            {% endif %}
        </li>
    </ul>

    <h2>Secrets (gitleaks)</h2>

    {% if secretFindings is empty %}
        <p style="color: green">No secret found.</p>
    {% else %}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Rule</th>
                    <th>File</th>
                    <th>Line</th>
                    <th>Match</th>
                    <th>Commit</th>
                </tr>
            </thead>
            <tbody>
            {% for finding in secretFindings %}
                <tr>
                    <td>{{ finding.ruleId }}</td>
                    <td>{{ finding.locations[0].physicalLocation.artifactLocation.uri ?? '-' }}</td>
                    <td>{{ finding.locations[0].physicalLocation.region.startLine ?? '-' }}</td>
                    <td><code>{{ finding.locations[0].physicalLocation.region.snippet.text ?? '-' }}</code></td>
                    <td>{{ finding.partialFingerprints.commitSha ?? '-' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h2>Trivy</h2>

    {% if trivyReportTxt is empty %}
        <p>Trivy report is empty.</p>
    {% else %}
        <pre>{{ trivyReportTxt }}</pre>
    {% endif %}

</div>
{% endblock %}

