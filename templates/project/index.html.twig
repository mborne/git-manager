{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Accueil{% endblock %}

{% block body %}
<div class="container-fluid">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h1 class="h3 mb-0">Projects</h1>
        <a class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" href="{{ path('api_project_list_csv') }}">
            <span class="material-icons fs-6">download</span>
            Export CSV
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table id="projects" class="table table-striped table-hover align-middle" width="100%"></table>
        </div>
    </div>

</div>
{% endblock %}


{% block javascripts %}
<script type="text/javascript">
$(document).ready(loadProjects);
</script>
{% endblock %}
