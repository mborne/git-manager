{
    "name": "mborne/git-manager",
    "type": "project",
    "description": "Command line helpers to manage hosted git repositories",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "MBO\\GitManager\\": "src"
        }
    },
    "bin": [
        "bin/console"
    ],
    "require": {
        "php": ">=8.3",
        "gitonomy/gitlib": "^1.5",
        "league/flysystem": "^3.30",
        "mborne/remote-git": "^0.11.1",
        "symfony/framework-bundle": "^6.4",
        "symfony/console": "^6.4",
        "symfony/runtime": "^6.4",
        "symfony/yaml": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/asset": "^6.4",
        "symfony/flex": "^2.10",
        "symfony/monolog-bundle": "^3.11",
        "symfony/dotenv": "6.4.*",
        "doctrine/doctrine-bundle": "^2.18",
        "doctrine/orm": "^3.3",
        "phpdocumentor/reflection-docblock": "^5.6",
        "phpstan/phpdoc-parser": "^2.3",
        "symfony/property-access": "6.4.*",
        "symfony/property-info": "6.4.*",
        "symfony/serializer": "6.4.*",
        "symfony/uid": "6.4.*"
    },
    "require-dev": {
        "symfony/browser-kit": "^6.4",
        "symfony/css-selector": "^6.4",
        "symfony/phpunit-bridge": "^6.4",
        "phpunit/phpunit": "^12",
        "php-coveralls/php-coveralls": "^2.9",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.90",
        "symfony/maker-bundle": "^1.65",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "vimeo/psalm": "^6.16",
        "psalm/plugin-symfony": "^5.3"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": [
            "@check-style",
            "@phpstan",
            "@phpunit"
        ],
        "phpunit": [
            "mkdir -p var/test-data var/output",
            "rm -rf var/test-data/* var/output/*",
            "bin/console --env=test doctrine:schema:update --force",
            "XDEBUG_MODE=coverage SYMFONY_DEPRECATIONS_HELPER='logFile=var/output/deprecations.log' vendor/bin/phpunit --log-junit var/output/junit-report.xml --coverage-clover var/output/clover.xml --coverage-html var/output/coverage"
        ],
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.dist.neon --error-format=raw",
        "check-style": [
            "echo \"-- Checking coding style using php-cs-fixer (run 'composer fix-style' if it fails)\"",
            "vendor/bin/php-cs-fixer fix src -v --dry-run --diff",
            "vendor/bin/php-cs-fixer fix tests -v --dry-run --diff"
        ],
        "fix-style": [
            "echo \"-- Fixing coding style using php-cs-fixer...\"",
            "vendor/bin/php-cs-fixer fix src",
            "vendor/bin/php-cs-fixer fix tests"
        ]
    },
    "scripts-descriptions": {
        "test": "Run coding style check, static analysis and unit tests",
        "phpunit": "Run unit tests with coverage reports in var/output",
        "phpstan": "Run static analysis using phpstan",
        "check-style": "Check coding style using php-cs-fixer",
        "fix-style": "Fix coding style using php-cs-fixer"
    },
    "config": {
        "sort-packages": false,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*",
            "docker": false
        }
    }
}
