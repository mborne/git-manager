# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

# allows to test the handling of the X-Forwarded-* headers
# ('REMOTE_ADDR' can't be used here, it is resolved from $_SERVER which is not set in CLI)
TRUSTED_PROXIES='127.0.0.1'

GIT_MANAGER_DIR='%kernel.project_dir%/var/test-data'
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test-data/database.db"
